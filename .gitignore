node_modules/

# 環境変数（.env.example だけは共有したいので除外しない）
.env
.env.*
!.env.example

# ビルド成果物
# backend/dist は Dockerfile 側で `npm run build` して作り直され、
# .gcloudignore でもデプロイ対象から外れているため、リポジトリには不要。
dist/
build/

# Python のバイトコードキャッシュ（hetzner-livekit/agent）
__pycache__/
*.pyc

# AIモデルのローカルキャッシュ（ビルド時に取得される）
.cache/

# ログ
*.log
npm-debug.log*
logs/

# エディタ・OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

/temp/*

# Generated from the matching .template files by render-config.sh — contains
# deploy-specific values, never commit them. Edit the .template instead.
hetzner-livekit/livekit.yaml
hetzner-livekit/egress.yaml

# noise-cancel-research の実験出力（音声・ONNXモデル、数十MB）。再生成は experiment_*.py で
noise-cancel-research/sample_noise/experiment/
